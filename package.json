{
  "name": "argent",
  "version": "0.0.1",
  "private": true,
  "description": "Open-source control plane for AI coding agents in persistent workspaces, with durable runs, independent verification, and human control. M0 simulator.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GregPat22/argent.git"
  },
  "bugs": {
    "url": "https://github.com/GregPat22/argent/issues"
  },
  "homepage": "https://github.com/GregPat22/argent#readme",
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start:api": "node --env-file-if-exists=.env dist/src/api.js",
    "start:worker": "node --env-file-if-exists=.env dist/src/worker-main.js",
    "demo": "npm run build && node dist/scripts/demo.js",
    "check": "npm run typecheck && npm run format:check && npm test"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "prettier": "3.9.10",
    "typescript": "5.8.3"
  }
}
