{
  "name": "argent",
  "version": "0.0.1",
  "private": true,
  "description": "Open-source desktop app for AI coding agents in persistent workspaces, with durable runs, independent verification and human control. Early prototype: runs Claude Code in local Git worktrees; the changes panel is in development, trusted tests and cloud workspaces are planned.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GregPat22/argent.git"
  },
  "bugs": {
    "url": "https://github.com/GregPat22/argent/issues"
  },
  "homepage": "https://github.com/GregPat22/argent#readme",
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "build": "tsc && node dist/scripts/build-assets.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test --test-concurrency=1 dist/tests/*.test.js",
    "start:api": "node --env-file-if-exists=.env dist/src/api.js",
    "start:worker": "node --env-file-if-exists=.env dist/src/worker-main.js",
    "demo": "npm run build && node dist/scripts/demo.js",
    "check": "npm run typecheck && npm run format:check && npm test",
    "desktop": "npm run build && electron dist/src/desktop/main.js",
    "desktop:smoke": "npm run build && node dist/scripts/desktop-smoke.js",
    "desktop:package": "npm run build && node dist/scripts/package-desktop.js",
    "site:preview": "npm run build && node dist/scripts/site-preview.js",
    "github:pilot": "npm run build && node dist/scripts/github-pilot.js",
    "continuity": "npm run build && node dist/scripts/continuity.js"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "22.19.0",
    "electron": "45.2.3",
    "prettier": "3.9.10",
    "typescript": "5.8.3"
  },
  "overrides": {
    "@electron/asar": {
      "glob": "14.0.4",
      "minimatch": "11.0.5"
    }
  }
}
